# macOS files
.DS_Store



# Based on Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin
gen
out

# Gradle files
.gradle
build

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation

# Android Studio captures folder
captures

# IntelliJ
*.iml
.idea

# Keystore files
# Uncomment the following line if you do not want to check your keystore files in.
#*.jks

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Helper build for relocating NewPipeExtractor
tools/shade/.gradle
tools/shade/build

# NOTE: android/libs/*.jar is generated by scripts/build-extractors.sh but is
# deliberately COMMITTED and published — npm tarballs cannot carry git
# submodules, so consuming apps have no other way to get the extractors.
# See CLAUDE.md. Do not add android/libs to this file.

# Local reference checkouts (PipePipeClient etc) - not part of the build
reference/
