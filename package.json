{
  "name": "capacitor-pipe",
  "version": "1.0.0",
  "description": "YouTube extraction for Capacitor, powered by PipePipeExtractor with NewPipeExtractor as a fallback. Includes full SABR support playable from Media3/ExoPlayer or any web player. Android only. Fully typed.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/libs/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "LICENSE"
  ],
  "author": "Harsh Mandan",
  "url": "https://harsh.ink",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshmandan/capacitor-pipe.git"
  },
  "bugs": {
    "url": "https://github.com/harshmandan/capacitor-pipe/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "android",
    "youtube",
    "pipepipe",
    "newpipe",
    "extractor",
    "sabr",
    "dash",
    "media3",
    "exoplayer"
  ],
  "scripts": {
    "verify": "bun run verify:android && bun run verify:web",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "bun run build",
    "lint": "bun run eslint && bun run prettier -- --check",
    "fmt": "bun run eslint -- --fix && bun run prettier -- --write",
    "eslint": "eslint .",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "docgen": "docgen --api PipePlugin --output-readme README.md --output-json dist/docs.json && bun run docgen:player",
    "build": "bun run clean && bun run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "extractors:init": "git submodule update --init --recursive",
    "extractors:build": "./scripts/build-extractors.sh",
    "extractors:update": "./scripts/update-extractors.sh",
    "extractors:check": "./scripts/check-divergences.sh",
    "prepublishOnly": "bun run build",
    "docgen:player": "docgen --api PipePlayerPlugin --output-readme docs/PLAYER.md --output-json dist/docs-player.json",
    "test": "tsc -p tsconfig.test.json && bun test"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/docgen": "^0.3.1",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@types/bun": "^1.4.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.6",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "packageManager": "bun@1.4.2"
}
