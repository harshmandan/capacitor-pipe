{
  "name": "capacitor-pipe",
  "version": "1.0.0",
  "description": "YouTube extraction for Capacitor, powered by PipePipeExtractor with NewPipeExtractor as a fallback. Includes full SABR support playable from Media3/ExoPlayer or any web player. Android only. Fully typed.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/libs/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "LICENSE"
  ],
  "author": "Harsh Mandan",
  "url": "https://harsh.ink",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshmandan/capacitor-pipe.git"
  },
  "bugs": {
    "url": "https://github.com/harshmandan/capacitor-pipe/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "android",
    "youtube",
    "pipepipe",
    "newpipe",
    "extractor",
    "sabr",
    "dash",
    "media3",
    "exoplayer"
  ],
  "scripts": {
    "verify": "bun run verify:android && bun run verify:web",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "bun run build && bun run test:assets",
    "lint": "bun run eslint && bun run prettier -- --check",
    "fmt": "bun run eslint -- --fix && bun run prettier -- --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "docgen": "docgen --api PipePlugin --output-readme README.md --output-json dist/docs.json && bun run docgen:player",
    "build": "bun run clean && bun run assets:build && bun run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "extractors:init": "git submodule update --init --recursive",
    "extractors:build": "./scripts/build-extractors.sh",
    "extractors:update": "./scripts/update-extractors.sh",
    "extractors:check": "./scripts/check-divergences.sh",
    "prepublishOnly": "bun run build",
    "docgen:player": "docgen --api PipePlayerPlugin --output-readme PLAYER.md --output-json dist/docs-player.json",
    "assets:build": "./scripts/build-assets.sh",
    "test:assets": "node scripts/test-assets.mjs",
    "preinstall": "node ./scripts/only-bun.mjs",
    "check:apk": "./scripts/check-apk-obfuscation.sh"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/docgen": "^0.3.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.2",
    "prettier-plugin-java": "^2.6.6",
    "rimraf": "^6.0.1",
    "rollup": "^4.30.1",
    "terser": "^5.50.0",
    "typescript": "~4.1.5"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  }
}
